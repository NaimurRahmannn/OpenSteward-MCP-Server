OPENSTEWARD_APP_NAME=OpenSteward
OPENSTEWARD_ENVIRONMENT=development
OPENSTEWARD_HOST=127.0.0.1
OPENSTEWARD_PORT=8000
OPENSTEWARD_LOG_LEVEL=INFO

# MCP caller authentication
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Map each named caller to its bearer token and allowed GitHub installation IDs.

OPENSTEWARD_MCP_AUTHORIZED_CALLERS={"mcp-inspector":{"token":"REPLACE_WITH_AT_LEAST_32_CHARACTERS","installation_ids":["app_installion_id"]}}


# GitHub App integration
# Choose either PRIVATE_KEY or PRIVATE_KEY_PATH, never both.

OPENSTEWARD_GITHUB_APP_ID=

OPENSTEWARD_GITHUB_PRIVATE_KEY_PATH=

OPENSTEWARD_GITHUB_API_URL=https://api.github.com
OPENSTEWARD_GITHUB_API_VERSION=2026-03-10
OPENSTEWARD_GITHUB_USER_AGENT=OpenSteward/0.1.0
OPENSTEWARD_GITHUB_REQUEST_TIMEOUT_SECONDS=15
OPENSTEWARD_GITHUB_RETRY_TIME_BUDGET_SECONDS=120
